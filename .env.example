# Sao chép file này thành .env.local khi chạy trên máy, hoặc khai báo trong Vercel → Settings → Environment Variables.

# Bắt buộc để form liên hệ gửi được email. Tạo tại https://resend.com/api-keys
RESEND_API_KEY=

# Email nhận yêu cầu tư vấn (nhiều email cách nhau bằng dấu phẩy)
CONTACT_TO_EMAIL=ceo@skv.lighting

# Địa chỉ gửi. Mặc định onboarding@resend.dev chỉ gửi được tới email đăng ký tài khoản Resend.
# Sau khi xác minh tên miền skv.lighting trên Resend, đổi thành ví dụ: SKV Website <website@skv.lighting>
CONTACT_FROM_EMAIL=SKV Website <onboarding@resend.dev>

# Địa chỉ website chính thức (dùng cho SEO, sitemap). Khi còn chạy thử có thể để địa chỉ *.vercel.app
NEXT_PUBLIC_SITE_URL=https://skv.lighting
